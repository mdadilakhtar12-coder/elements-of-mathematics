rules_version = '2';
// Multi-institute coaching app.
//
// Isolation: everything an institute owns lives under institutes/{inst}/... and a signed-in user
// only gets in when their custom claim `inst` (set by Cloud Functions, never by the client) equals {inst}.
// Plans: `institutes/{inst}.features` and `.status/.expiresAt` are read here, so a suspended / expired
// institute or a switched-off feature is blocked on the server, whatever the app does.
// Accounts, plan, usage and limits are written only by Cloud Functions (admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.get('sa', false) == true; }
    function inInst(inst) { return signedIn() && request.auth.token.get('inst', '') == inst; }

    function instDoc(inst) { return get(/databases/$(database)/documents/institutes/$(inst)).data; }
    function instLive(inst) {
      return instDoc(inst).status == 'active'
        && (instDoc(inst).get('expiresAt', null) == null || instDoc(inst).expiresAt > request.time);
    }
    function feat(inst, f) { return instDoc(inst).get('features', {}).get(f, false) == true; }

    function meDoc(inst) {
      return get(/databases/$(database)/documents/institutes/$(inst)/users/$(request.auth.uid)).data;
    }
    // A usable member: right institute, institute live, own account active.
    // Students can use the app only when the plan includes student login (Free does not).
    function member(inst) {
      return inInst(inst) && instLive(inst) && meDoc(inst).active == true
        && (meDoc(inst).role != 'student' || feat(inst, 'student_login'));
    }
    // Sub-admin rights: a real sub-admin, or a teacher the admin has also made a sub-admin (setTeacherAdmin function).
    function hasAdminAccess(inst) {
      return meDoc(inst).role == 'subadmin'
        || (meDoc(inst).role == 'teacher' && meDoc(inst).get('alsoSubadmin', false) == true);
    }
    function roleIs(inst, r) { return member(inst) && meDoc(inst).role == r; }
    function isAdmin(inst) { return roleIs(inst, 'admin'); }
    function isTeacher(inst) { return roleIs(inst, 'teacher'); }
    function can(inst, p) {
      return member(inst) && (meDoc(inst).role == 'admin'
        || (hasAdminAccess(inst) && p in meDoc(inst).get('perms', [])));
    }
    function isStaffOrTeacher(inst) {
      return member(inst) && meDoc(inst).role in ['admin', 'subadmin', 'teacher'];
    }

    // ---- who may see / touch what (tightened: students and teachers get only what is theirs) ----
    function isStudent(inst) { return roleIs(inst, 'student'); }
    function myBatchIds(inst) { return meDoc(inst).get('batchIds', []); }
    // A student of that batch (batchId comes from the document being read).
    function studentOf(inst, batchId) { return isStudent(inst) && batchId in myBatchIds(inst); }
    function batchDoc(inst, batchId) {
      return get(/databases/$(database)/documents/institutes/$(inst)/batches/$(batchId)).data;
    }
    // A teacher of that batch. `teacherIds` is kept on the batch by the app and re-checked by a Cloud Function.
    function teaches(inst, batchId) {
      return isTeacher(inst) && request.auth.uid in batchDoc(inst, batchId).get('teacherIds', []);
    }
    // Teacher writing a document that carries `batchId` (homework, notices, exams, marks, materials):
    // only for a batch they teach, and they cannot move it to another batch.
    function teacherBatchWrite(inst) {
      return request.method == 'delete'
        ? teaches(inst, resource.data.batchId)
        : (resource == null
            ? teaches(inst, request.resource.data.batchId)
            : (resource.data.batchId == request.resource.data.batchId && teaches(inst, resource.data.batchId)));
    }
    function classDoc(inst, classId) {
      return get(/databases/$(database)/documents/institutes/$(inst)/classes/$(classId)).data;
    }
    // Teacher marking attendance: only for a class that is theirs (covers substitutes) and not yet approved / cancelled.
    function teacherAttendanceWrite(inst) {
      let cid = request.method == 'delete' ? resource.data.classId : request.resource.data.classId;
      return isTeacher(inst)
        && (request.method != 'update' || resource.data.classId == request.resource.data.classId)
        && classDoc(inst, cid).teacherId == request.auth.uid
        && classDoc(inst, cid).status in ['scheduled', 'rejected', 'taken'];
    }

    // Everything not matched below is denied.

    // ---------- global, read-only data ----------
    match /plans/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- the institute ----------
    match /institutes/{inst} {
      // Members may read it even when suspended, so the app can show the reason.
      allow read: if inInst(inst) || isSuper();
      allow write: if false; // Cloud Functions only (plan, limits, usage, status, expiry)

      // ---- accounts ----
      match /users/{uid} {
        // Own profile; admins and sub-admins see everyone; a teacher sees students only
        // (not other teachers' pay); a student sees nobody else.
        allow read: if (inInst(inst) && request.auth.uid == uid)
          || (member(inst) && (meDoc(inst).role == 'admin' || hasAdminAccess(inst)))
          || (isTeacher(inst) && resource.data.role == 'student');
        allow create, delete: if false; // createUser / deleteUser Cloud Functions (limits + Auth account)
        // role, loginId, active, createdAt can never be changed from the app.
        allow update: if (
              isAdmin(inst)
              || (can(inst, 'users') && resource.data.role in ['student', 'teacher'])
              || (can(inst, 'batches') && resource.data.role == 'student'
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['batchIds']))
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'mobile', 'perms', 'batchIds', 'rollNo', 'standard', 'parentMobile',
              'monthlyFee', 'subjects', 'classRate', 'salary', 'teacherType'
            ])
            // only the admin hands out permissions
            && (isAdmin(inst) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['perms']));
      }

      // ---- push devices (FCM tokens). Each user manages only their own; Cloud Functions read them to send. ----
      match /devices/{token} {
        allow read, delete: if member(inst) && resource.data.uid == request.auth.uid;
        allow create, update: if member(inst) && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'role', 'platform', 'updatedAt']);
      }

      // ---- activity log (who changed fees / accounts). Written by Cloud Functions, read by the admin. ----
      match /activity/{id} {
        allow read: if isAdmin(inst);
        allow write: if false;
      }

      // ---- core features (every plan) ----
      match /batches/{id} {
        allow read: if isStaffOrTeacher(inst) || studentOf(inst, id);
        allow write: if can(inst, 'batches');
      }
      match /classes/{id} {
        allow read: if isStaffOrTeacher(inst) || studentOf(inst, resource.data.batchId);
        allow create, delete: if can(inst, 'schedule') || can(inst, 'attendance');
        // A teacher may only hand in their own class for approval ("taken"): never approve it,
        // never touch it once approved / cancelled, never change date, batch or teacher.
        allow update: if can(inst, 'schedule') || can(inst, 'attendance')
          || (isTeacher(inst)
              && resource.data.teacherId == request.auth.uid
              && resource.data.status in ['scheduled', 'rejected', 'taken']
              && request.resource.data.status == 'taken'
              && request.resource.data.get('approvedBy', '') == ''
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'topic', 'note', 'takenBy', 'takenAt', 'approvedBy']));
      }
      match /attendance/{id} {
        allow read: if isStaffOrTeacher(inst) || (member(inst) && resource.data.studentId == request.auth.uid);
        allow write: if can(inst, 'attendance') || teacherAttendanceWrite(inst);
      }
      match /notices/{id} {
        // batchId '' = for everyone
        allow read: if isStaffOrTeacher(inst)
          || (isStudent(inst) && (resource.data.batchId == '' || resource.data.batchId in myBatchIds(inst)));
        allow write: if can(inst, 'notices') || teacherBatchWrite(inst);
      }
      match /homework/{id} {
        allow read: if isStaffOrTeacher(inst) || studentOf(inst, resource.data.batchId);
        allow write: if can(inst, 'notices') || teacherBatchWrite(inst);
      }
      // Subject list, WhatsApp message texts.
      match /settings/{id} {
        allow read: if member(inst);
        // settings/fees (UPI id for payments) belongs to whoever handles fees; the rest to notices.
        allow write: if id == 'fees' ? can(inst, 'fees') : can(inst, 'notices');
      }

      // ---- exams (feature: exams) ----
      match /exams/{id} {
        allow read: if feat(inst, 'exams') && (isStaffOrTeacher(inst) || studentOf(inst, resource.data.batchId));
        allow write: if feat(inst, 'exams') && (can(inst, 'exams') || teacherBatchWrite(inst));
      }
      match /marks/{id} {
        allow read: if member(inst) && feat(inst, 'exams')
          && (isStaffOrTeacher(inst) || resource.data.studentId == request.auth.uid);
        allow write: if feat(inst, 'exams') && (can(inst, 'exams') || teacherBatchWrite(inst));
      }
      match /leaderboards/{id} {
        // document id = batch id
        allow read: if feat(inst, 'exams') && (isStaffOrTeacher(inst) || studentOf(inst, id));
        allow write: if feat(inst, 'exams') && (can(inst, 'exams') || teaches(inst, id));
      }

      // ---- fees (feature: fees) ----
      match /fees/{id} {
        allow read: if member(inst) && feat(inst, 'fees')
          && (can(inst, 'fees') || resource.data.studentId == request.auth.uid);
        // Staff record payments under their own id; only the admin may change or delete one.
        // Every create / change / delete is also written to the activity log by a Cloud Function.
        allow create: if feat(inst, 'fees') && can(inst, 'fees') && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if feat(inst, 'fees') && isAdmin(inst);
      }

      // ---- accounts (feature: accounts) ----
      match /ledger/{id} {
        allow read, write: if feat(inst, 'accounts') && can(inst, 'fees');
      }
      match /bills/{id} {
        allow read, write: if feat(inst, 'accounts') && can(inst, 'fees');
      }
      match /salaryPaid/{id} {
        allow read: if member(inst) && feat(inst, 'accounts')
          && (can(inst, 'fees') || resource.data.teacherId == request.auth.uid);
        allow write: if feat(inst, 'accounts') && can(inst, 'fees');
      }

      // ---- study material (feature: study) ----
      match /materials/{id} {
        allow read: if feat(inst, 'study') && (isStaffOrTeacher(inst) || studentOf(inst, resource.data.batchId));
        allow write: if feat(inst, 'study') && (can(inst, 'notices') || teacherBatchWrite(inst));
      }

      // ---- doubts (feature: doubts) ----
      match /doubts/{id} {
        allow read: if member(inst) && feat(inst, 'doubts')
          && (resource.data.studentId == request.auth.uid || isStaffOrTeacher(inst));
        allow create: if member(inst) && feat(inst, 'doubts') && request.resource.data.studentId == request.auth.uid;
        allow update: if feat(inst, 'doubts') && isStaffOrTeacher(inst);
        allow delete: if member(inst) && feat(inst, 'doubts')
          && (resource.data.studentId == request.auth.uid || isStaffOrTeacher(inst));
      }
      // Photo of a doubt (document id = doubt id): the student who asked, and staff / teachers.
      match /doubtPhotos/{id} {
        function doubtOwner() {
          return get(/databases/$(database)/documents/institutes/$(inst)/doubts/$(id)).data.studentId == request.auth.uid;
        }
        allow read, delete: if member(inst) && feat(inst, 'doubts') && (isStaffOrTeacher(inst) || doubtOwner());
        allow create: if member(inst) && feat(inst, 'doubts') && doubtOwner();
      }

      // ---- leaves (feature: leaves) ----
      match /leaves/{id} {
        allow read: if member(inst) && feat(inst, 'leaves')
          && (resource.data.teacherId == request.auth.uid || can(inst, 'attendance'));
        allow create: if feat(inst, 'leaves') && isTeacher(inst)
          && request.resource.data.teacherId == request.auth.uid && request.resource.data.status == 'pending';
        allow update: if feat(inst, 'leaves') && can(inst, 'attendance');
        allow delete: if feat(inst, 'leaves') && (can(inst, 'attendance')
          || (member(inst) && resource.data.teacherId == request.auth.uid && resource.data.status == 'pending'));
      }
    }
  }
}
