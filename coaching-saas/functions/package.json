{
  "name": "coachsaas-functions",
  "private": true,
  "description": "Cloud Functions for the multi-institute coaching app (accounts, plans, limits, super admin)",
  "main": "src/index.js",
  "engines": { "node": "20" },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-coachsaas \"node --test test/rules/*.test.js\"",
    "test:functions": "firebase emulators:exec --only firestore,auth --project demo-coachsaas \"node --test --test-concurrency=1 test/integration/*.test.js\"",
    "test:all": "npm test && npm run test:rules && npm run test:functions",
    "deploy": "firebase deploy --only functions,firestore"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.0",
    "firebase-tools": "^13.0.0"
  }
}
