rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    // The owner/admin login. Keep this email in sync with AppConfig.ADMIN_EMAIL.
    function isOwner() { return signedIn() && request.auth.token.email == 'admin@aspire.app'; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && me().active == true; }
    function role() { return me().role; }
    function isAdmin() { return isOwner() || (active() && role() == 'admin'); }
    function can(p) {
      return isOwner() || (active() && (role() == 'admin' || (role() == 'subadmin' && p in me().perms)));
    }
    function isTeacher() { return active() && role() == 'teacher'; }
    function isStaffOrTeacher() { return isOwner() || (active() && role() in ['admin', 'subadmin', 'teacher']); }

    // ---- users ----
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaffOrTeacher());
      // Admin creates everyone. Sub-admins with the "users" permission can only create students/teachers.
      allow create: if isAdmin()
                    || (can('users') && request.resource.data.role in ['student', 'teacher']);
      allow update: if isAdmin()
                    || (can('users') && resource.data.role in ['student', 'teacher']
                        && request.resource.data.role in ['student', 'teacher'])
                    || (can('batches') && resource.data.role == 'student');
      allow delete: if isAdmin()
                    || (can('users') && resource.data.role in ['student', 'teacher']);
    }

    // Passwords set by the admin (so the admin can look them up / reset them).
    match /credentials/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin()
                      || (can('users') && resource.data.role in ['student', 'teacher']));
      allow write: if signedIn() && (request.auth.uid == uid || isAdmin()
                      || (can('users') && request.resource.data.role in ['student', 'teacher']));
    }

    match /batches/{id} {
      allow read: if signedIn();
      allow write: if can('batches');
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if can('schedule') || can('attendance')
                   || (isTeacher() && resource != null && resource.data.teacherId == request.auth.uid
                       && request.resource.data.teacherId == request.auth.uid);
    }

    match /attendance/{id} {
      allow read: if signedIn();
      allow write: if can('attendance') || isTeacher();
    }

    match /exams/{id} {
      allow read: if signedIn();
      allow write: if can('exams') || isTeacher();
    }

    match /marks/{id} {
      allow read: if signedIn() && (isStaffOrTeacher() || resource.data.studentId == request.auth.uid);
      allow write: if can('exams') || isTeacher();
    }

    // Teacher pay marked as paid.
    match /salaryPaid/{id} {
      allow read: if signedIn() && (can('fees') || resource.data.teacherId == request.auth.uid);
      allow write: if can('fees');
    }

    // Photos of expense bills.
    match /bills/{id} {
      allow read, write: if can('fees');
    }

    // Study material links, per batch.
    match /materials/{id} {
      allow read: if signedIn();
      allow write: if can('notices') || isTeacher();
    }

    // Student doubts and the teacher's answers.
    match /doubts/{id} {
      allow read: if signedIn() && (resource.data.studentId == request.auth.uid || isStaffOrTeacher());
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if isStaffOrTeacher();
      allow delete: if signedIn() && (resource.data.studentId == request.auth.uid || isStaffOrTeacher());
    }

    match /doubtPhotos/{id} {
      allow read, create, delete: if signedIn();
    }

    // Income and expenses of the institute.
    match /ledger/{id} {
      allow read, write: if can('fees');
    }

    match /fees/{id} {
      allow read: if signedIn() && (can('fees') || resource.data.studentId == request.auth.uid);
      allow write: if can('fees');
    }

    // Texts of the WhatsApp messages, editable by the admin.
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if can('notices');
    }

    // Class rankings, rebuilt whenever exam marks are saved.
    match /leaderboards/{id} {
      allow read: if signedIn();
      allow write: if can('exams') || isTeacher();
    }

    match /homework/{id} {
      allow read: if signedIn();
      allow write: if can('notices') || isTeacher();
    }

    match /notices/{id} {
      allow read: if signedIn();
      allow write: if can('notices') || isTeacher();
    }
  }
}
