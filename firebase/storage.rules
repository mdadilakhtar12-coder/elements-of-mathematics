rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Replace with the same email as AppConfig.ADMIN_EMAIL
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "mdadilakhtar12@gmail.com";
    }

    match /pdfs/{file} {
      allow get: if request.auth != null;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }
    match /banners/{file} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
