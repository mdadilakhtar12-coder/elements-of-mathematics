rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace with the same email as AppConfig.ADMIN_EMAIL
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "admin@example.com";
    }

    // Students can read everything; only the admin can add/edit/delete.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
